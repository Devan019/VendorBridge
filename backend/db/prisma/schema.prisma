// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Or your preferred database (mysql, sqlite, etc.)
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  password_hash String
  role          String
  created_at    DateTime       @default(now())
  rfqs          RFQ[]          @relation("CreatedBy")
  approvals     Approval[]
  notifications Notification[]
  logs          ActivityLog[]
}

model Vendor {
  id            String       @id @default(uuid())
  name          String
  category      String
  gst_number    String       @unique
  contact_email String
  status        String
  rfqs          RFQ_Vendor[]
  quotations    Quotation[]
}

model RFQ {
  id           String       @id @default(uuid())
  title        String
  description  String
  deadline     DateTime
  status       String
  created_by   String
  creator      User         @relation("CreatedBy", fields: [created_by], references: [id])
  items        RFQ_Item[]
  vendors      RFQ_Vendor[]
  quotations   Quotation[]
  pos          PurchaseOrder[]
}

model RFQ_Item {
  id         String            @id @default(uuid())
  rfq_id     String
  rfq        RFQ               @relation(fields: [rfq_id], references: [id])
  product_name String
  quantity   Int
  unit       String
  q_items    Quotation_Item[]
}

model RFQ_Vendor {
  rfq_id    String
  vendor_id String
  rfq       RFQ    @relation(fields: [rfq_id], references: [id])
  vendor    Vendor @relation(fields: [vendor_id], references: [id])

  @@id([rfq_id, vendor_id])
}

model Quotation {
  id           String           @id @default(uuid())
  rfq_id       String
  rfq          RFQ              @relation(fields: [rfq_id], references: [id])
  vendor_id    String
  vendor       Vendor           @relation(fields: [vendor_id], references: [id])
  status       String
  submitted_at DateTime         @default(now())
  items        Quotation_Item[]
  approvals    Approval[]
  pos          PurchaseOrder[]
}

model Quotation_Item {
  id            String    @id @default(uuid())
  quotation_id  String
  quotation     Quotation @relation(fields: [quotation_id], references: [id])
  rfq_item_id   String
  rfq_item      RFQ_Item  @relation(fields: [rfq_item_id], references: [id])
  unit_price    Decimal
  delivery_days Int
}

model Approval {
  id           String    @id @default(uuid())
  quotation_id String
  quotation    Quotation @relation(fields: [quotation_id], references: [id])
  approver_id  String
  approver     User      @relation(fields: [approver_id], references: [id])
  status       String
  remarks      String?
  decided_at   DateTime  @default(now())
}

model PurchaseOrder {
  id           String    @id @default(uuid())
  rfq_id       String
  rfq          RFQ       @relation(fields: [rfq_id], references: [id])
  quotation_id String
  quotation    Quotation @relation(fields: [quotation_id], references: [id])
  po_number    String    @unique
  status       String
  created_at   DateTime  @default(now())
  invoices     Invoice[]
}

model Invoice {
  id             String        @id @default(uuid())
  po_id          String
  po             PurchaseOrder @relation(fields: [po_id], references: [id])
  invoice_number String        @unique
  tax_amount     Decimal
  total          Decimal
  status         String
}

model ActivityLog {
  id            String   @id @default(uuid())
  entity_type   String
  entity_id     String
  action        String
  performed_by  String
  user          User     @relation(fields: [performed_by], references: [id])
  timestamp     DateTime @default(now())
}

model Notification {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id])
  message    String
  read       Boolean  @default(false)
  created_at DateTime @default(now())
}