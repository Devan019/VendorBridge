// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum VendorStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
}

enum RFQStatus {
  DRAFT
  SENT
  CLOSED
}

enum UserRole {
  ADMIN
  MANAGER
  PROCUREMENT_OFFICER
  VENDOR
}
enum QuotationStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id             String         @id @default(uuid())
  first_name           String
  last_name            String
  email          String         @unique
  password_hash  String
  role           UserRole
  phone          String?
  country        String?
  image_url      String?
  created_at     DateTime       @default(now())
  logs           ActivityLog[]
  approvals      Approval[]
  notifications  Notification[]
  rfqs           RFQ[]          @relation("CreatedBy")
  refresh_tokens RefreshToken[]
  vendorNotes    VendorNote[]
}

model Vendor {
  id            String       @id @default(uuid())
  name          String
  category      String
  tags          String[]     @default([])
  gst_number    String       @unique
  contact_email String
  address       String?
  created_at    DateTime     @default(now())
  phone         String?
  updated_at    DateTime
  status        VendorStatus @default(ACTIVE)
  quotations    Quotation[]
  rfqs          RFQ_Vendor[]
  vendorNotes   VendorNote[]
}

model VendorNote {
  id         String   @id @default(uuid())
  vendor_id  String
  vendor     Vendor   @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  author_id  String?
  author     User?    @relation(fields: [author_id], references: [id])
  content    String
  created_at DateTime @default(now())
}

model RFQ {
  id             String           @id @default(uuid())
  title          String
  description    String
  deadline       DateTime
  status         String
  created_by     String
  pos            PurchaseOrder[]
  quotations     Quotation[]
  creator        User             @relation("CreatedBy", fields: [created_by], references: [id])
  items          RFQ_Item[]
  vendors        RFQ_Vendor[]
  rfqAttachments RFQ_Attachment[]
}

model RFQ_Item {
  id           String           @id @default(uuid())
  rfq_id       String
  rfq          RFQ              @relation(fields: [rfq_id], references: [id], onDelete: Cascade)
  product_name String
  description  String?
  quantity     Int
  unit         String
  unit_price   Decimal?
  q_items      Quotation_Item[]
}

model RFQ_Attachment {
  id            String   @id @default(uuid())
  rfq_id        String
  rfq           RFQ      @relation(fields: [rfq_id], references: [id], onDelete: Cascade)
  filename      String
  original_name String
  mime_type     String
  size_bytes    Int
  path          String
  uploaded_at   DateTime @default(now())
}

model RFQ_Vendor {
  rfq_id    String
  vendor_id String
  rfq       RFQ    @relation(fields: [rfq_id], references: [id], onDelete: Cascade)
  vendor    Vendor @relation(fields: [vendor_id], references: [id])

  @@id([rfq_id, vendor_id])
}

model Quotation {
  id           String           @id @default(uuid())
  rfq_id       String
  vendor_id    String
  submitted_at DateTime         @default(now())
  approvals    Approval[]
  pos          PurchaseOrder[]
  rfq          RFQ              @relation(fields: [rfq_id], references: [id])
  vendor       Vendor           @relation(fields: [vendor_id], references: [id])
  items        Quotation_Item[]
  status       QuotationStatus  @default(SUBMITTED)
  notes        String?          // vendor-level notes / cover letter
  updated_at   DateTime         @updatedAt
  @@unique([rfq_id, vendor_id])  // one quotation per vendor per RFQ
}

model Quotation_Item {
  id            String    @id @default(uuid())
  quotation_id  String
  quotation     Quotation @relation(fields: [quotation_id], references: [id], onDelete: Cascade)
  rfq_item_id   String
  unit_price    Decimal
  delivery_days Int
  rfq_item      RFQ_Item  @relation(fields: [rfq_item_id], references: [id])
  notes         String?   // per-line notes from vendor
}

model Approval {
  id           String    @id @default(uuid())
  quotation_id String
  approver_id  String
  status       String
  remarks      String?
  decided_at   DateTime  @default(now())
  approver     User      @relation(fields: [approver_id], references: [id])
  quotation    Quotation @relation(fields: [quotation_id], references: [id])
}

model PurchaseOrder {
  id           String    @id @default(uuid())
  rfq_id       String
  quotation_id String
  po_number    String    @unique
  status       String
  created_at   DateTime  @default(now())
  invoices     Invoice[]
  quotation    Quotation @relation(fields: [quotation_id], references: [id])
  rfq          RFQ       @relation(fields: [rfq_id], references: [id])
}

model Invoice {
  id             String        @id @default(uuid())
  po_id          String
  invoice_number String        @unique
  tax_amount     Decimal
  total          Decimal
  status         String
  po             PurchaseOrder @relation(fields: [po_id], references: [id])
}

model ActivityLog {
  id           String   @id @default(uuid())
  entity_type  String
  entity_id    String
  action       String
  performed_by String
  user         User     @relation(fields: [performed_by], references: [id])
  timestamp    DateTime @default(now())
}

model Notification {
  id         String   @id @default(uuid())
  user_id    String
  message    String
  read       Boolean  @default(false)
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id])
}

model RefreshToken {
  id         String   @id @default(uuid())
  token      String   @unique
  session_id String
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  expires_at DateTime
  created_at DateTime @default(now())

  @@index([session_id])
  @@index([expires_at])
}