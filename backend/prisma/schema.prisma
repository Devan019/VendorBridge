generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password_hash String
  created_at    DateTime       @default(now())
  country       String?
  first_name    String         @default("")
  last_name     String         @default("")
  phone         String?
  role          UserRole       @default(VENDOR)
  image_key     String?
  name          String
  logs          ActivityLog[]
  approvals     Approval[]
  notifications Notification[]
  rfqs          RFQ[]          @relation("CreatedBy")
  refreshTokens RefreshToken[]
  vendorNotes   VendorNote[]
}

model Vendor {
  id            String       @id @default(uuid())
  name          String
  category      String
  gst_number    String       @unique
  contact_email String
  address       String?
  created_at    DateTime     @default(now())
  phone         String?
  tags          String[]     @default([])
  updated_at    DateTime
  status        VendorStatus @default(ACTIVE)
  quotations    Quotation[]
  rfqs          RFQ_Vendor[]
  vendorNotes   VendorNote[]
}

model VendorNote {
  id         String   @id @default(uuid())
  vendor_id  String
  author_id  String?
  content    String
  created_at DateTime @default(now())
  author     User?    @relation(fields: [author_id], references: [id])
  vendor     Vendor   @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
}

model RFQ {
  id               String           @id @default(uuid())
  title            String
  description      String
  deadline         DateTime
  created_by       String
  created_at       DateTime         @default(now())
  reference_number String           @unique
  updated_at       DateTime         @updatedAt
  status           RFQStatus        @default(DRAFT)
  pos              PurchaseOrder[]
  quotations       Quotation[]
  creator          User             @relation("CreatedBy", fields: [created_by], references: [id])
  rfqAttachments   RFQ_Attachment[]
  items            RFQ_Item[]
  vendors          RFQ_Vendor[]
}

model RFQ_Item {
  id           String           @id @default(uuid())
  rfq_id       String
  product_name String
  quantity     Int
  unit         String
  description  String?
  unit_price   Decimal?
  q_items      Quotation_Item[]
  rfq          RFQ              @relation(fields: [rfq_id], references: [id], onDelete: Cascade)
}

model RFQ_Attachment {
  id            String   @id @default(uuid())
  rfq_id        String
  filename      String
  original_name String
  mime_type     String
  size_bytes    Int
  path          String
  uploaded_at   DateTime @default(now())
  rfq           RFQ      @relation(fields: [rfq_id], references: [id], onDelete: Cascade)
}

model RFQ_Vendor {
  rfq_id    String
  vendor_id String
  rfq       RFQ    @relation(fields: [rfq_id], references: [id], onDelete: Cascade)
  vendor    Vendor @relation(fields: [vendor_id], references: [id])

  @@id([rfq_id, vendor_id])
}

model Quotation {
  id           String           @id @default(uuid())
  rfq_id       String
  vendor_id    String
  status       QuotationStatus  @default(SUBMITTED)
  submitted_at DateTime         @default(now())
  notes        String?
  updated_at   DateTime         @updatedAt
  approvals    Approval[]
  pos          PurchaseOrder[]
  rfq          RFQ              @relation(fields: [rfq_id], references: [id])
  vendor       Vendor           @relation(fields: [vendor_id], references: [id])
  items        Quotation_Item[]

  @@unique([rfq_id, vendor_id])
}

model Quotation_Item {
  id            String    @id @default(uuid())
  quotation_id  String
  rfq_item_id   String
  unit_price    Decimal
  delivery_days Int
  notes         String?
  quotation     Quotation @relation(fields: [quotation_id], references: [id], onDelete: Cascade)
  rfq_item      RFQ_Item  @relation(fields: [rfq_item_id], references: [id])
}

model Approval {
  id           String         @id @default(uuid())
  quotation_id String
  approver_id  String
  remarks      String?
  decided_at   DateTime?
  created_at   DateTime       @default(now())
  level        Int            @default(1)
  status       ApprovalStatus @default(PENDING)
  approver     User           @relation(fields: [approver_id], references: [id])
  quotation    Quotation      @relation(fields: [quotation_id], references: [id], onDelete: Cascade)
}

model PurchaseOrder {
  id           String    @id @default(uuid())
  rfq_id       String
  quotation_id String
  po_number    String    @unique
  created_at   DateTime  @default(now())
  created_by   String
  grand_total  Decimal   @default(0)
  gst_rate     Decimal   @default(18)
  issued_at    DateTime?
  notes        String?
  subtotal     Decimal   @default(0)
  tax_amount   Decimal   @default(0)
  terms        String?
  updated_at   DateTime  @updatedAt
  vendor_id    String
  status       POStatus  @default(DRAFT)
  invoices     Invoice[]
  items        PO_Item[]
  quotation    Quotation @relation(fields: [quotation_id], references: [id])
  rfq          RFQ       @relation(fields: [rfq_id], references: [id])
}

model PO_Item {
  id           String        @id @default(uuid())
  po_id        String
  product_name String
  description  String?
  quantity     Int
  unit         String
  unit_price   Decimal
  gst_rate     Decimal       @default(18)
  tax_amount   Decimal       @default(0)
  total        Decimal       @default(0)
  po           PurchaseOrder @relation(fields: [po_id], references: [id], onDelete: Cascade)
}

model Invoice {
  id             String        @id @default(uuid())
  po_id          String
  invoice_number String        @unique
  tax_amount     Decimal       @default(0)
  created_at     DateTime      @default(now())
  due_date       DateTime?
  email_sent_at  DateTime?
  grand_total    Decimal       @default(0)
  invoice_date   DateTime      @default(now())
  notes          String?
  paid_at        DateTime?
  subtotal       Decimal       @default(0)
  updated_at     DateTime      @updatedAt
  status         InvoiceStatus @default(DRAFT)
  po             PurchaseOrder @relation(fields: [po_id], references: [id])
}

model ActivityLog {
  id           String   @id @default(uuid())
  entity_type  String
  entity_id    String
  action       String
  performed_by String
  timestamp    DateTime @default(now())
  user         User     @relation(fields: [performed_by], references: [id])
}

model Notification {
  id          String   @id @default(uuid())
  user_id     String
  message     String
  read        Boolean  @default(false)
  created_at  DateTime @default(now())
  entity_id   String?
  entity_type String?
  title       String
  type        String   @default("INFO")
  user        User     @relation(fields: [user_id], references: [id])
}

model RefreshToken {
  id         String   @id @default(uuid())
  token      String   @unique
  session_id String
  user_id    String
  expires_at DateTime
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([session_id])
  @@index([expires_at])
}

enum VendorStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
}

enum RFQStatus {
  DRAFT
  SENT
  CLOSED
}

enum UserRole {
  ADMIN
  MANAGER
  PROCUREMENT_OFFICER
  VENDOR
  REVIEWER
}

enum QuotationStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  ESCALATED
}

enum POStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}
